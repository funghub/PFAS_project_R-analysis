# set the root dir as [1] "/home/lawrence/Documents/School/thesis/PFAS_R-analysis"
library(tidyverse)
# Load additional libraries that might be useful (these may need to be installed)
library(ggplot2)
library(pheatmap)
library(RColorBrewer)
library(VennDiagram)
library(gProfileR)
# convert gene id to symbols
library(org.Hs.eg.db)
library(annotate)
library(dplyr) # this is to load piping %>%
select <- dplyr::select # this is to help with the conflict of select()
count <- dplyr::count
library(DESeq2)
library(ggplot2)
library(pheatmap)
# SRR_ref <- read.csv("./data/data_input_deseq/metadata_ref/ref_metadata_all.csv") %>%
# select(-'replicate')#
SRR_PFAS <- read.csv("./results_from_analysis/data_input_deseq/metadata_PFAS/PFAS_metadata_all.csv") # this is unfiltered duration
# bind the water SRRs into SRR_PFAS
SRR_water <- read.csv("./results_from_analysis/data_input_deseq/metadata_ref/ref_water_metadata.csv") %>%
select(-'replicate')
head(SRR_water)
# SRR_all <- rbind(SRR_ref, SRR_PFAS)
SRR_all <- rbind(SRR_PFAS, SRR_water)
head(SRR_all)
unique(SRR_all$duration)
SRR_filtered <- SRR_all %>%
filter(duration %in% c(1,10)) # not select() because select is for col
unique(SRR_filtered$duration)
metadata_PFAS <- read.csv("./data/metadata/pfas/SraRunTable.csv")
# metadata_ref <- read.csv("./data/metadata/ref/SraRunTable.csv", row.names = 1)
head(metadata_PFAS)
# head(metadata_ref)
metadata_PFAS_filtered_joined <- merge(metadata_PFAS_filtered, SRR_filtered, by = "SRR", all = TRUE) %>%
mutate(chemical = chemical.y) # this so that we only have one chemical col (will be used by DESeq)
# test if these two are same length, same order, same values
identical(SRR_filtered$SRR, metadata_PFAS$Run)
# test if (SRR_filtered) in (metadata of all SRR) = should be TRUE
all(SRR_filtered$SRR %in% metadata_PFAS$Run)
# test if (metadata of all SRR) in (SRR_filtered) = should be FALSE
all(metadata_PFAS$Run %in% SRR_filtered$SRR)
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR) %>%
rename('Run'='SRR') # need to rename Run to SRR
# confirm that the SRR sample#s are all the same now contain only duration=1,10
identical(sort(SRR_filtered$SRR), sort(metadata_PFAS_filtered$SRR))
setdiff(SRR_filtered$SRR,metadata_PFAS_filtered$SRR) # should have no diff
# right merge duration and dose of SRR_all (based on SRR_all$SRR with metadata_PFAS_filtered$Run)
head(metadata_PFAS_filtered)
head(SRR_filtered)
setdiff(metadata_PFAS_filtered$SRR, SRR_filtered$SRR)   # in metadata_PFAS_filtered but not SRR_all
setdiff(SRR_filtered$SRR, metadata_PFAS_filtered$SRR)   # in SRR_all but not metadata_PFAS_filtered
unique(metadata_PFAS_filtered$chemical)
unique(SRR_filtered$chemical.y)
metadata_PFAS_filtered_joined <- merge(metadata_PFAS_filtered, SRR_filtered, by = "SRR", all = TRUE) %>%
mutate(chemical = chemical.y) # this so that we only have one chemical col (will be used by DESeq)
head(metadata_PFAS_filtered_joined)
nrow(metadata_PFAS_filtered_joined)
nrow(SRR_filtered)
dim(metadata_PFAS_filtered_joined)
dim(SRR_filtered)
# head(metadata_PFAS_filtered)
head(metadata_PFAS_filtered_joined) # now it has duration and dose
unique(metadata_PFAS_filtered_joined$chemical)
colnames(metadata_PFAS_filtered_joined)
unique(metadata_PFAS_filtered$chemical)
unique(SRR_filtered$chemical.y)
unique(metadata_PFAS_filtered_joined$chemical)
# Lead the reference counts files for PFAS dataset
markdups_counts_pfas <- read.table("./data/featureCounts/star_old/pfas/markdups_counts_pfas.txt", header=TRUE, sep = "\t", row.names = 1)
raw_counts_pfas <- read.table("./data/featureCounts/star_old/pfas/raw_counts_pfas.txt", header=TRUE, sep ="\t", row.names = 1)
# markdups_counts_ref <- read.table("./data/featureCounts/ref/markdups_counts_ref.txt", header=TRUE, sep = "\t", row.names = 1)
# raw_counts_ref <- read.table("./data/featureCounts/ref/raw_counts_ref.txt", header=TRUE, sep ="\t", row.names = 1)
# Replace everything after _ and the _ with nothing in all column names
markdups_counts_pfas_cleancols <- markdups_counts_pfas %>%
rename_with(~gsub("_.*", "", .x)) %>%
select(-c("Chr", "Start", "End", "Strand", "Length"))
raw_counts_pfas_cleancols <- raw_counts_pfas %>%
rename_with(~gsub("_.*", "", .x)) %>%
select(-c("Chr", "Start", "End", "Strand", "Length"))
