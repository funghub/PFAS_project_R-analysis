comparison_ref
head(comparison_ref)
ggplot(comparison_ref, aes(x = GC_pct, y = mean)) +
geom_point(na.rm = TRUE) +
labs(
title = "Average Number of Reads per GC Content of Probe",
x = "GC Percentage of the Probe",
y = "Average Count"
)
ggplot(comparison_ref, aes(x = GC_pct, y = mean)) +
geom_point(na.rm = TRUE) +
labs(
title = "Average Number of Reads per GC Content of Probe",
x = "GC Percentage of the Probe",
y = "Average Count"
) +
scale_x_continuous(labels = scales::label_percent()) +
