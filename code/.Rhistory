library(shiny); runApp('analysis_app_new.R')
library(edgeR)
library(dplyr)
library(scales)
setwd("/home/lawrence/Documents/School/thesis/PFAS_project_R-analysis")
knitr::opts_chunk$set(echo = TRUE) # Sets the global default for code chunks so that R source code is printed in the knitted report alongside its output
knitr::opts_knit$set(root.dir = here::here()) # left from Rmd # Changes the working directory for all subsequent code chunks to the project's root folder
# CREATE the Master Counts File (PFAS dataset + Ref Dataset)
## Ref dataset counts (featureCounts raw, not markdups)
raw_counts_ref <- read.table("./data/featureCounts/bowtie/ref/raw_counts.txt", header=TRUE, sep = "\t", row.names = 1)
## Replace everything after _ and the _ with nothing in all column names
raw_counts_ref_cleancols <- raw_counts_ref %>%
rename_with(~gsub("_.*", "", .x)) %>%
select(-c("Chr", "Start", "End", "Strand", "Length"))
## PFAS dataset counts (featureCounts raw, not markdups)
raw_counts_pfas <- read.table("./data/featureCounts/bowtie/pfas/raw_counts.txt", header=TRUE, sep = "\t", row.names = 1)
# Replace everything after _ and the _ with nothing in all column names
raw_counts_pfas_cleancols <- raw_counts_pfas %>%
rename_with(~gsub("_.*", "", .x)) %>%
select(-c("Chr", "Start", "End", "Strand", "Length"))
head(raw_counts_ref_cleancols)
head(raw_counts_pfas_cleancols)
# check that the row names are the same so that means genes are the same
# then combine the columns if true
if (identical(rownames(raw_counts_pfas_cleancols), rownames(raw_counts_ref_cleancols))) {
raw_counts_all <- cbind(raw_counts_pfas_cleancols, raw_counts_ref_cleancols)
} else {
stop("Row names do NOT match between raw_counts_pfas_cleancols and raw_counts_ref_cleancols — check gene order/IDs before combining.")
}
metadata_all <- read.csv("./results_from_analysis/data_input_deseq/metadata_all.csv")
# align metadata rows to counts columns, then rename SRR to chemical_duration_dose
# (replicates share a combo, so make.unique appends _1, _2, ...)
metadata_all <- metadata_all[match(colnames(raw_counts_all), metadata_all$SRR), ]
stopifnot(identical(colnames(raw_counts_all), metadata_all$SRR))
sample_id <- make.unique(
paste(gsub(" ", "_", metadata_all$chemical),
paste0(metadata_all$duration, "d"),
paste0(metadata_all$dose,"uM"), #\u00b5M
sep = "-"),
sep = "-"
)
metadata_all$sample_id <- sample_id
rownames(metadata_all) <- sample_id
colnames(raw_counts_all) <- sample_id
print("metadata_all validate sample_id START")
print(head(metadata_all$sample_id))
print(head(metadata_all$chemical))
print(head(metadata_all$duration))
print(head(metadata_all$dose))
print("metadata_all validate sample_id END")
head(raw_counts_all)
# remove the X column since have them as row names already
metadata_all <- metadata_all %>% select(-c(X))
head(metadata_all)
head(raw_counts_all)
# Create sum row of total reads in sample
# raw_counts_all_sum <- colSums(raw_counts_all)
# head(raw_counts_all_sum)
# raw_counts_all_sum["DMSO_pfas-1d-0uM"] # how to access a value
# Calculating CPM
raw_counts_all_norm <- as.data.frame(
lapply(raw_counts_all, function (x) (x / sum(x))*1e6)
# lapply function to everything in column (sees df as list of columns) x is the entire column
# inside function, it takes that x-column and divide by the sum of x-column
)
rownames(raw_counts_all_norm) <- rownames(raw_counts_all)
raw_counts_all_norm
keep <- rowSums(raw_counts_all_norm > 1) >= 0.1 * ncol(raw_counts_all_norm)
# transform the raw_counts_all_norm by filtering out those low count genes
raw_counts_all_norm_f <- raw_counts_all_norm[keep,]
# df for log2 of count subtract from median of the gene is the same as
# log2((raw_counts_all_norm+1) / apply(raw_counts_all_norm + 1, 1, median))
difference_log <- log2(raw_counts_all_norm_f+1) - apply(log2(raw_counts_all_norm_f+1), 1, median)
# apply() on rows to find the median of the gene
fraction_DE <- colMeans(abs(difference_log)>1) # find where abs(log2fold) is > 1
summary(fraction_DE)
keep <- rowSums(raw_counts_all_norm > 1) >= 0.1 * ncol(raw_counts_all_norm)
# transform the raw_counts_all_norm by filtering out those low count genes
raw_counts_all_norm_f <- raw_counts_all_norm[keep,]
head(raw_counts_all_norm_f)
# colnames(raw_counts_all_norm_f)
lcpm <- log2(raw_counts_all_norm_f + 1) # change all counts to log2 scale
# group = sample name without the replicate suffix
group <- sub("\\.[0-9]+$", "", colnames(lcpm)) # vector of names without the suffix
# table(group)          # replicates per condition, sanity check
# bad_samples <- c("water.1d.0uM", "water.1d.0uM.6")
# lcpm <- lcpm[, !colnames(lcpm) %in% bad_samples]
#
# group <- sub("\\.[0-9]+$", "", colnames(lcpm))     # recompute from the cleaned names
#
# lcpm_avg <- sapply(split(seq_along(group), group),
#                    function(i) rowMeans(lcpm[, i, drop = FALSE]))
#
# length(group) == ncol(lcpm)                        # TRUE
# table(group)["water.1d.0uM"]                       # 30, not 32
#
# length(group); ncol(lcpm)     # if these differ, that is the problem
# split(seq_along(group), group) # position of each column-seq_along, group is vector of all the columns without suffixes
# this gives the column positions belonging to $sample_names
lcpm_avg <- sapply(split(seq_along(group), group),
function(i) rowMeans(lcpm[, i, drop = FALSE])) # drop = FALSE so not output as vector
# sapply(column positions, function)
# for each of those column, put it into the function
# split(seq_along(group), group)[[1]]
dim(lcpm_avg)
# rowMeans(lcpm[, c("DMSO_pfas.1d.0uM","PFBS.14d.0.1uM.1"), drop = FALSE])
# split(seq_along(group), group)
# unique(group) # all sample names without replicates
pfas_M_1d <- lcpm_avg - lcpm_avg[, "DMSO_pfas.4d.0uM"] # every count subtract from each gene count for this control col
pfas_frac_DE_1d <- colMeans(abs(pfas_M_1d[, grepl("\\.4d\\.", colnames(pfas_M_1d))]) > 1)
# PFAS columns at 1 days (starts with PF, contains ".4d.")
# get the column names that are PFAS 1d
cat("\nColumns that are PFAS 1d:\n")
pfas_1d <- grep("^PF[^.]*\\.1d\\.", colnames(lcpm_avg), value = TRUE)
pfas_1d                                       # check which columns were picked
pfas_M_1d <- lcpm_avg[, pfas_1d, drop = FALSE] - lcpm_avg[, "DMSO_pfas.1d.0uM"] # compute log2fold change only for those found pfas 1d names of their gene counts from the control counts per gene
cat("\nSample log2fold change:\n")
head(abs(pfas_M_1d[,c(1,2,3,4,5)]) > 1) # see sample
cat("\nSample mean of counts per sample for log2fold change > 1:\n")
colMeans(abs(pfas_M_1d[,c(1,2,3,4,5)]) > 1) # see sample
cat("\n----------------------------------------------------------------------\n")
cat("\nMEAN log2fold change of PFAS 1d v.s. DMSO 1d:\n")
pfas_frac_DE_1d <- colMeans(abs(pfas_M_1d) > 1)
# find genes where abs(log2fold) is > 1
# for those true >1 geneXsample, find the mean of those counts per sample
pfas_frac_DE_1d
# --------------------------------------------------
# CALCULATE percentage of genes differentially expressed log2fold > 1
pfas_1d_n_genes <- nrow(pfas_M_1d)
pfas_1d_n_DE <- colSums(abs(pfas_M_1d)>1)
# split by direction
pfas_1d_n_up   <- colSums(pfas_M_1d >  1)
pfas_1d_n_down <- colSums(pfas_M_1d < -1)
cat("\nPercentage of Genes Differentially Expressed:\n")
data.frame(
# sample = colnames(pfas_M_1d),
total_genes = pfas_1d_n_genes,
genes_up = pfas_1d_n_up,
genes_down = pfas_1d_n_down,
genes_DE = pfas_1d_n_DE,
percent_DE = percent(round(pfas_1d_n_DE / pfas_1d_n_genes, 3),
accuracy=0.1))
duration = "10d"
chemicals = c("PF")
group_chemicals = paste(chemicals, collapse="|")
# PFAS columns at 1 days (starts with PF, contains ".4d.")
# get the column names that are PFAS 1d'
cat("\nColumns that are",paste(chemicals, collapse=", "),duration,":\n")
samples_names <- c(grep(sprintf("^(%s)[^.]*\\.% s\\.", group_chemicals, duration),
colnames(lcpm_avg), value = TRUE) # % s for string placeholder
# grep(sprintf("^WY\\.14643\\.% s\\.", duration),
#    colnames(lcpm_avg), value = TRUE)
)
samples_names                                       # check which columns were picked
log_fold_changes <- lcpm_avg[, samples_names, drop = FALSE] - lcpm_avg[, sprintf("DMSO_pfas.% s.0uM", duration)]
# compute log2fold change only for those found pfas 1d names of their gene counts from the control counts per gene
# --------------------------------------------------
# CALCULATE percentage of genes differentially expressed log2fold > 1
n_genes <- nrow(log_fold_changes)
n_DE <- colSums(abs(log_fold_changes)>1)
# split by direction
n_up   <- colSums(log_fold_changes >  1)
n_down <- colSums(log_fold_changes < -1)
cat("\nPercentage of Genes Differentially Expressed:\n")
data.frame(
# sample = colnames(log_fold_changes),
total_genes = n_genes,
genes_up = n_up,
genes_down = n_down,
genes_DE = n_DE,
percent_DE = percent(round(n_DE / n_genes, 3),
accuracy=0.1))
grep("^DMSO[^.]*", colnames(lcpm_avg), value = TRUE)
grep("^water[^.]*", colnames(lcpm_avg), value = TRUE)
