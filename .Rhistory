head(raw_counts_pfas_cleancols)
# head(markdups_counts_ref_cleancols)
# head(raw_counts_ref_cleancols)
raw_ref_counts_water <- read.csv("./results_from_analysis/data_input_deseq/water_ref/raw_counts_water.csv",row.names = 1)
markdups_ref_counts_water <- read.csv("./results_from_analysis/data_input_deseq/water_ref/markdups_counts_water.csv",row.names = 1)
head(raw_ref_counts_water)
head(markdups_ref_counts_water)
if (identical(rownames(markdups_counts_pfas_cleancols), rownames(markdups_ref_counts_water))) {
markdups_counts_pfas_cleancols <- cbind(markdups_counts_pfas_cleancols, markdups_ref_counts_water)
} else {
stop("Row names do NOT match between markdups_counts_pfas_cleancols and markdups_ref_counts_water — check gene order/IDs before combining.")
}
if (identical(rownames(raw_counts_pfas_cleancols), rownames(raw_ref_counts_water))) {
raw_counts_pfas_cleancols <- cbind(raw_counts_pfas_cleancols, raw_ref_counts_water)
} else {
stop("Row names do NOT match between raw_counts_pfas_cleancols and raw_ref_counts_water — check gene order/IDs before combining.")
}
water_srrs <- SRR_water$SRR
all(water_srrs %in% colnames(markdups_counts_pfas_cleancols))
all(water_srrs %in% colnames(raw_counts_pfas_cleancols))
# are cols of counts in rows of metadata = NO
all(colnames(markdups_counts_pfas_cleancols) %in% metadata_PFAS_filtered_joined$SRR)
# are rows of metadata in cols of counts = YES, bc meta is filtered and we see if filtered is in all
all(metadata_PFAS_filtered_joined$SRR %in% colnames(markdups_counts_pfas_cleancols))
dim(markdups_counts_pfas_cleancols)
nrow(markdups_counts_pfas_cleancols) # number of genes
ncol(markdups_counts_pfas_cleancols) # number of samples
dim(metadata_PFAS_filtered_joined)
nrow(metadata_PFAS_filtered_joined) # number of samples duration 1 or 10 from PFAS dataset
ncol(markdups_counts_pfas_cleancols) == nrow(metadata_PFAS_filtered_joined)
# sort(colnames(markdups_counts_pfas_cleancols)) == sort(rownames(metadata))
head(metadata_PFAS_filtered_joined)
unique(metadata_PFAS_filtered_joined$duration)
# Filter metadata to only have duration = 1
metadata_PFAS_filtered_joined_test <- metadata_PFAS_filtered_joined %>%
filter(duration == 1)
head(metadata_PFAS_filtered_joined_test)
unique(metadata_PFAS_filtered_joined_test$duration)
# select only columns/samples if they are in the metadata file
markdups_counts_pfas_cleancols_filtered <- markdups_counts_pfas_cleancols %>%
select(metadata_PFAS_filtered_joined$SRR)
head(markdups_counts_pfas_cleancols_filtered)
# validation
all(colnames(markdups_counts_pfas_cleancols_filtered) %in% metadata_PFAS_filtered_joined$SRR)
all(metadata_PFAS_filtered_joined$SRR %in% colnames(markdups_counts_pfas_cleancols_filtered))
setdiff(metadata_PFAS_filtered_joined$SRR,colnames(markdups_counts_pfas_cleancols_filtered))
setdiff(colnames(markdups_counts_pfas_cleancols_filtered),metadata_PFAS_filtered_joined$SRR)
dim(markdups_counts_pfas_cleancols_filtered)
ncol(markdups_counts_pfas_cleancols_filtered) # number of samples
dim(metadata_PFAS_filtered_joined)
nrow(metadata_PFAS_filtered_joined) # number of samples duration 1 or 10 from PFAS dataset
ncol(markdups_counts_pfas_cleancols_filtered) == nrow(metadata_PFAS_filtered_joined)
# markdups_counts_aligned <- markdups_counts_pfas_cleancols[, rownames(metadata)]
# make sure that col of counts is in the same order as rows in metadata file
markdups_counts_aligned <- markdups_counts_pfas_cleancols_filtered[
match(colnames(markdups_counts_pfas_cleancols_filtered), metadata_PFAS_filtered_joined$SRR)
]
# match(x, table) — for each value in x, finds its position in table
#returns a vector of row-positions in metadata_PFAS_filtered_joined corresponding to each column name, in order
nrow(metadata_PFAS_filtered_joined) == ncol(markdups_counts_aligned)
identical(colnames(markdups_counts_aligned), metadata_PFAS_filtered_joined$SRR)
# look up the options for chemical, for choosing factors (from lookup table, includes water)
unique(metadata_PFAS_filtered_joined$chemical)
head(metadata_PFAS_filtered_joined)
unique(metadata_PFAS_filtered_joined$duration)
dds <- DESeqDataSetFromMatrix(
countData = markdups_counts_aligned,
colData = metadata_PFAS_filtered_joined,
design = ~ chemical
# design = ~ chemical + duration
)
dds
head(metadata_PFAS_filtered_joined)
unique(metadata_PFAS_filtered_joined$chemical)
# unique(metadata_PFAS_filtered_joined$chemical)[2]
# number of unique combos for chem, duration, dose
count(metadata_PFAS_filtered_joined, chemical, duration, dose)
min(count(metadata_PFAS_filtered_joined, chemical, duration, dose)$n)
# Pre-filtering: Remove low count genes
# dds <- dds[rowSums(counts(dds)) > 0, ] #10
# head(dds)
smallestGroupSize <- min(count(metadata_PFAS_filtered_joined, chemical, dose)$n) # smallest replicate number
# keep <- rowSums(counts(dds) >= 10) >= smallestGroupSize # original
keep <- rowSums(counts(dds) > 0) >= smallestGroupSize
dds <- dds[keep,]
# factor levels
# dds$condition <- factor(dds$chemical, levels = c("untreated","treated"))
dds$chemical <- relevel(dds$chemical, ref = c("DMSO")) # use DMSO as the reference
# dds$chemical <- relevel(dds$chemical, ref = c("water"))
# running the differential expression pipeline
dds <- DESeq(dds)
# extracts the estimated log2 fold changes and p values for the last variable in the design formula
# build results table
results <- results(dds)
results <- results[order(results$padj), ]
head(results)
