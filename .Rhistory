library(scales)
# scale_y_continuous(labels = label_comma())      # 1,500,000
# or
# scale_y_continuous(labels = label_number(scale = 1e-6, suffix = "M"))  # 1.5M
reads_distr <- read.table("~/Documents/School/thesis/PFAS_project_preprocessing_pipeline/Results_from_pipeline/bowtie/pfas_manifest_v1.2/end2end/pfas_v1.2_bowtie2_se_plot.tsv", header=TRUE, sep = "\t")
reads_distr
reads_distr$Sample <- gsub("_bowtie","",reads_distr$Sample)
# import the metadata file from analysis app
metadata_pfas <- read.csv("/home/lawrence/Documents/School/thesis/PFAS_project_R-analysis/results_from_analysis/data_input_deseq/metadata_all.csv")  %>% select(X,SRR,chemical,duration,dose) %>% filter(chemical %in% c("DMSO_pfas","PFBS","PFOS","PFDS","PFOA")) %>% rename("Sample" = "SRR")
metadata_pfas
unique(metadata_pfas$chemical)
merged_df <- full_join(metadata_pfas, reads_distr, by = "Sample")
merged_df
merged_df_arranged <- merged_df %>% arrange(chemical,duration,dose)
merged_df_arranged
chemical_summary <- merged_df %>% group_by(chemical,duration,dose) %>%
summarise(
mean_unique_mapped = mean(SE.mapped.uniquely, na.rm = TRUE),
total_samples = n()
) %>%
arrange(chemical,duration,dose,mean_unique_mapped)
chemical_summary
chemical_summary <- merged_df %>% group_by(chemical,duration) %>%
summarise(
mean_unique_mapped = mean(SE.mapped.uniquely, na.rm = TRUE),
total_samples = n()
) %>%
arrange(chemical,duration,mean_unique_mapped)
chemical_summary
ggplot(chemical_summary, aes(x = chemical, y = mean_unique_mapped, fill = chemical)) +
geom_col(position = "dodge") + #stack is the other option
facet_wrap(~ duration, scales = "free_y",
labeller = labeller(duration = function(x) paste("Day", x))) +
# apply function to facet variable to add "day"
labs(
title = "Mean of Uniquely Mapped Reads by Chemical Treatment",
subtitle = "Comparing read depths across different durations (days)",
x = "Chemical",
y = "Mean of Uniquely Mapped Reads",
fill = "Chemical"
) +
theme_minimal() +
scale_fill_brewer(palette = "Set1") +
scale_y_continuous(labels = label_comma()) +     # 1,500,000
theme(
axis.text.x = element_text(angle = 45, hjust = 1), # Rotates chemical names so they don't overlap
legend.position = "none" # Hide legend since X-axis labels already show the chemicals
)
chemical_summary_simple <- merged_df %>% group_by(chemical) %>%
summarise(
mean_unique_mapped = mean(SE.mapped.uniquely, na.rm = TRUE),
total_samples = n()
)
chemical_summary_simple
ggplot(chemical_summary_simple, aes(x = reorder(chemical, mean_unique_mapped), y = mean_unique_mapped, fill = chemical)) +
geom_col() +
coord_flip() + # Horizontal bars are easier to read
labs(
title = "Overall Mean Uniquely Mapped Reads per Chemical",
x = "Chemical",
y = "Mean Uniquely Mapped Reads"
) +
theme_minimal() +
scale_fill_brewer(palette = "Set1") +
scale_y_continuous(labels = label_comma()) +     # 1,500,000
theme(legend.position = "none")
ggplot(merged_df, aes(x = chemical, y = SE.mapped.uniquely, fill = chemical)) +
geom_boxplot(alpha = 0.5, outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.9) + # Shows individual samples as dots
labs(
title = "Reads Aligned Distribution Across PFAS Chemicals",
x = "Chemical",
y = "Uniquely Mapped Reads"
) +
theme_minimal() +
scale_y_continuous(labels = label_comma()) +     # 1,500,000
scale_fill_brewer(palette = "Set1") +
theme(legend.position = "none")
ggplot(merged_df, aes(x = chemical, y = SE.not.aligned, fill = chemical)) +
# ggplot(merged_df, aes(x = chemical, y = SE.mapped.uniquely, fill = chemical)) +
geom_boxplot(alpha = 0.5, outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.9) + # Shows individual samples as dots
labs(
title = "Reads Not Aligned Distribution Across PFAS Chemicals",
x = "Chemical",
y = "Reads Not Aligned"
) +
theme_minimal() +
scale_y_continuous(labels = label_comma()) +     # 1,500,000
scale_fill_brewer(palette = "Set1") +
theme(legend.position = "none")
ggplot(merged_df, aes(x = chemical, y = SE.multimapped, fill = chemical)) +
# ggplot(merged_df, aes(x = chemical, y = SE.mapped.uniquely, fill = chemical)) +
geom_boxplot(alpha = 0.5, outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.9) + # Shows individual samples as dots
labs(
title = "Read Multi Mapped Distribution Across PFAS Chemicals",
x = "Chemical",
y = "Multi Mapped Reads"
) +
theme_minimal() +
scale_y_continuous(labels = label_comma()) +     # 1,500,000
scale_fill_brewer(palette = "Set1") +
theme(legend.position = "none")
library(dplyr)
library(tibble)
library(stringr)
library(ggplot2)
# import pfas featurecounts v1.2 end2end
raw_counts_pfas <- read.table("~/Documents/School/thesis/PFAS_project_preprocessing_pipeline/Results_from_pipeline/bowtie/pfas_manifest_v1.2/end2end/featurecounts_probenames/raw_counts_probenames.txt", header=TRUE, sep = "\t", row.names = 1) %>% select(-c("Chr","Start","End","Strand","Length"))
# import ref featurecounts v2 end2end
raw_counts_ref <- read.table("~/Documents/School/thesis/PFAS_project_preprocessing_pipeline/Results_from_pipeline/bowtie/ref/end2end/featurecounts_probenames/raw_counts_probenames.txt", header=TRUE, sep = "\t", row.names = 1) %>% select(-c("Chr","Start","End","Strand","Length"))
raw_counts_pfas_sums <- data.frame(mean = rowMeans(raw_counts_pfas))
raw_counts_ref_sums <- data.frame(mean = rowMeans(raw_counts_ref))
# import the manifest v2
manifest_v2 <- read.csv("~/Documents/School/thesis/PFAS_project_preprocessing_pipeline/manifest/100766_homo_sapiens_s1500_2.0_full_manifest_revB_2024.csv") %>% select("GENE_SYMBOL","PROBE_NAME","PROBE_SEQUENCE") %>% rename()
# import the manifest v1.2
manifest_v1 <- read.csv("~/Documents/School/thesis/PFAS_project_preprocessing_pipeline/manifest_v1/181019+Human+S1500++Surrogate+1.2+Manifest.csv") %>% select("Gene.Symbol","Probe.name","Probe.Sequence") %>% rename("GENE_SYMBOL"="Gene.Symbol","PROBE_NAME"="Probe.name","PROBE_SEQUENCE"="Probe.Sequence")
manifest_v2
manifest_v1
manifest_v2$GC_ct <- str_count(manifest_v2$PROBE_SEQUENCE,c("[GC]"))
manifest_v1$GC_ct <- str_count(manifest_v1$PROBE_SEQUENCE,c("[GC]"))
manifest_v2$seq_len <- nchar(manifest_v2$PROBE_SEQUENCE)
manifest_v1$seq_len <- nchar(manifest_v1$PROBE_SEQUENCE)
manifest_v2$GC_pct <- manifest_v2$GC_ct/manifest_v2$seq_len
manifest_v1$GC_pct <- manifest_v1$GC_ct/manifest_v1$seq_len
ggplot(manifest_v2, aes(x=GC_pct)) +
geom_histogram(color = "black", fill = "steelblue") +
labs(x = "GC Percentage", y = "Number of Probes") +
scale_x_continuous(labels = scales::label_percent()) +
ggtitle("Histogram of GC% of the Probes in Manifest v2") +
theme_minimal()
ggplot(manifest_v1, aes(x=GC_pct)) +
geom_histogram(color = "black", fill = "steelblue") +
labs(x = "GC Percentage", y = "Number of Probes") +
scale_x_continuous(labels = scales::label_percent()) +
ggtitle("Histogram of GC% of the Probes in Manifest v1.2") +
theme_minimal()
setdiff(manifest_v1$PROBE_NAME,rownames(raw_counts_pfas_sums))
setdiff(manifest_v2$PROBE_NAME,rownames(raw_counts_ref_sums))
comparison_ref <- raw_counts_ref_sums %>%
rownames_to_column("PROBE_NAME") %>%
inner_join(manifest_v2 %>% select(PROBE_NAME, GC_pct, seq_len), by = "PROBE_NAME")
comparison_pfas <- raw_counts_pfas_sums %>%
rownames_to_column("PROBE_NAME") %>%
inner_join(manifest_v1 %>% select(PROBE_NAME, GC_pct, seq_len), by = "PROBE_NAME")
nrow(comparison_ref); nrow(raw_counts_ref_sums)  # check few probes were lost
nrow(comparison_pfas); nrow(raw_counts_pfas_sums)  # check few probes were lost
head(comparison_ref)
dim(comparison_ref)
#reference
ggplot(comparison_ref, aes(x = GC_pct, log10(mean + 1))) +
geom_point(alpha = 0.3, size = 1) +
# geom_point(na.rm = TRUE) +
geom_smooth(method = "gam", color = "red", se = TRUE) + # gam for large datasets >1000
labs(
title = "Average Number of Reads per GC % of Probe: Reference Dataset Manifest v2",
x = "GC Percentage of the Probe",
y = "log10(average count + 1)"
) +
scale_x_continuous(labels = scales::label_percent()) +
theme_minimal()
#pfas
ggplot(comparison_pfas, aes(x = GC_pct, log10(mean + 1))) +
geom_point(alpha = 0.3, size = 1) +
# geom_point(na.rm = TRUE) +
geom_smooth(method = "gam", color = "red", se = TRUE) + # gam for large datasets >1000
labs(
title = "Average Number of Reads per GC % of Probe: PFAS Dataset Manifest v1.2",
x = "GC Percentage of the Probe",
y = "log10(average count + 1)"
) +
scale_x_continuous(labels = scales::label_percent()) +
theme_minimal()
ggplot(manifest_v2, aes(x=seq_len)) +
geom_histogram(color = "black", fill = "steelblue") +
