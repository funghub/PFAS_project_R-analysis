library(VennDiagram)
library(gProfileR)
# convert gene id to symbols
library(org.Hs.eg.db)
library(annotate)
library(dplyr) # this is to load piping %>%
select <- dplyr::select # this is to help with the conflict of select()
count <- dplyr::count
library(DESeq2)
library(ggplot2)
library(pheatmap)
# SRR_ref <- read.csv("./data/data_input_deseq/metadata_ref/ref_metadata_all.csv") %>%
# select(-'replicate')#
SRR_PFAS <- read.csv("./results_from_analysis/data_input_deseq/metadata_PFAS/PFAS_metadata_all.csv") # this is unfiltered duration
# bind the water SRRs into SRR_PFAS
SRR_water <- read.csv("./results_from_analysis/data_input_deseq/metadata_ref/ref_water_metadata.csv") %>%
select(-'replicate')
head(SRR_water)
# SRR_all <- rbind(SRR_ref, SRR_PFAS)
SRR_all <- rbind(SRR_PFAS, SRR_water)
head(SRR_all)
unique(SRR_all$duration)
SRR_filtered <- SRR_all %>%
filter(duration %in% c(1,10)) # not select() because select is for col
unique(SRR_filtered$duration)
metadata_PFAS <- read.csv("./data/metadata/pfas/SraRunTable.csv")
# metadata_ref <- read.csv("./data/metadata/ref/SraRunTable.csv", row.names = 1)
head(metadata_PFAS)
# head(metadata_ref)
# test if these two are same length, same order, same values
identical(SRR_filtered$SRR, metadata_PFAS$Run)
# test if (SRR_filtered) in (metadata of all SRR) = should be TRUE
all(SRR_filtered$SRR %in% metadata_PFAS$Run)
# test if (metadata of all SRR) in (SRR_filtered) = should be FALSE
all(metadata_PFAS$Run %in% SRR_filtered$SRR)
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR) %>%
rename('SRR'='Run') # need to rename Run to SRR
metadata_PFAS
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR) %>%
rename('SRR'='Run') # need to rename Run to SRR
filter(Run %in% SRR_filtered$SRR)
metadata_PFAS
SRR_filtered
setdiff(SRR_filtered$SRR,metadata_PFAS_filtered$SRR) # should have no diff
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR) %>%
rename('SRR'='Run') # need to rename Run to SRR
SRR_filtered
metadata_PFAS_filtered
metadata_PFAS
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR)
metadata_PFAS_filtered
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR) %>%
rename('SRR'='Run') # need to rename Run to SRR
metadata_PFAS_filtered <- metadata_PFAS %>%
filter(Run %in% SRR_filtered$SRR) %>%
rename('Run'='SRR') # need to rename Run to SRR
# confirm that the SRR sample#s are all the same now contain only duration=1,10
identical(sort(SRR_filtered$SRR), sort(metadata_PFAS_filtered$SRR))
setdiff(SRR_filtered$SRR,metadata_PFAS_filtered$SRR) # should have no diff
knitr::opts_knit$set(root.dir = here::here())
knitr::opts_chunk$set(echo = TRUE)
