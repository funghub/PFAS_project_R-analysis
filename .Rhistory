ggplot(manifest_v2, aes(x=seq_len)) +
geom_histogram(color = "black", fill = "steelblue") +
labs(x = "Probe Sequence Length", y = "Number of Probes") +
# scale_x_continuous(labels = scales::label_percent()) +
ggtitle("Number of Probes per Sequence Length in Manifest v2") +
