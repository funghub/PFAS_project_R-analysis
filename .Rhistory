df_10d_dmso_ref <- data.frame(
sample = colnames(log_fold_changes),
total_genes = n_genes,
genes_up = n_up,
genes_down = n_down,
genes_DE = n_DE,
percent_DE = percent(round(n_DE / n_genes, 3),
accuracy=0.1))
df_10d_dmso_ref
duration = "10d"
chemicals = c("caffeine","sucrose","potassium_chloride")
group_chemicals = paste(chemicals, collapse="|")
# PFAS columns at 1 days (starts with PF, contains ".4d.")
# get the column names that are PFAS 1d'
cat("\nColumns that are",paste(chemicals, collapse=", "),duration,":\n")
samples_names <- c(grep(sprintf("^(%s)[^.]*\\.% s\\.", group_chemicals, duration),
colnames(lcpm_avg), value = TRUE) # % s for string placeholder
# grep(sprintf("^WY\\.14643\\.% s\\.", duration),
#    colnames(lcpm_avg), value = TRUE)
)
samples_names                                       # check which columns were picked
log_fold_changes <- lcpm_avg[, samples_names, drop = FALSE] - lcpm_avg[, sprintf("water.% s.0uM", duration)]
# compute log2fold change only for those found pfas 1d names of their gene counts from the control counts per gene
# --------------------------------------------------
# CALCULATE percentage of genes differentially expressed log2fold > 1
n_genes <- nrow(log_fold_changes)
n_DE <- colSums(abs(log_fold_changes)>1)
# split by direction
n_up   <- colSums(log_fold_changes >  1)
n_down <- colSums(log_fold_changes < -1)
cat("\nPercentage of Genes Differentially Expressed:\n")
df_10d_water_ref <- data.frame(
sample = colnames(log_fold_changes),
total_genes = n_genes,
genes_up = n_up,
genes_down = n_down,
genes_DE = n_DE,
percent_DE = percent(round(n_DE / n_genes, 3),
accuracy=0.1))
df_10d_water_ref
library(ggplot2)
library(dplyr)
library(readr)
combined_df <- rbind(df_1d_dmso_ref, df_1d_water_ref, df_10d_dmso_ref, df_10d_water_ref)
# 1. Convert "50.8%" (character) to 50.8 (numeric)
combined_df_fixed <- mutate(combined_df, percent_num = parse_number(percent_DE))
ggplot(combined_df_fixed, aes(x = percent_num)) +
geom_histogram(
binwidth = 10,       # Bucket size (e.g., 10% wide)
boundary = 0,        # Aligns buckets cleanly (0-10, 10-20, etc.)
fill = "steelblue",
color = "black"
) +
scale_x_continuous(breaks = seq(0, 100, by = 10)) +
labs(
title = "Distribution of Percent DE Across Treatment Conditions in Reference Dataset\n(Bowtie2 end-to-end manifest v2)",
x = "Percent DE (%)",
y = "Number of Conditions"
) +
theme_minimal()
# contains only sample: caffeine","sucrose","potassium_chloride, acetaminophen","aflatoxin_B1","cyclosporin_A","WY.14643","rosiglitazone","troglitazone
# no DMSO or technical control samples
# replicates are averaged already
# (Rows Represent Treatments)
# (summarizing unique chemical-dose-duration groups after replicate-averaging and subsetting)
combined_df_fixed
summary(combined_df_fixed$percent_num)
count(combined_df_fixed$percent_num > 50)
sum(combined_df_fixed$percent_num > 50)
sum(combined_df_fixed$percent_num < 50)
combined_df_fixed
