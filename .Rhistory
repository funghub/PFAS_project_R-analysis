#   rename_with(~gsub("_.*", "", .x)) %>%
#   select(-c("Chr", "Start", "End", "Strand", "Length"))
#
# head(markdups_counts_pfas_cleancols)
# head(raw_counts_pfas_cleancols)
#
# head(markdups_counts_ref_cleancols)
# head(raw_counts_ref_cleancols)
# dds = DESeqDataSet
dds <- DESeqDataSetFromMatrix(
countData = markdups_counts_aligned, # sample gene counts unnormalized
colData = metadata_markdups, # metadata info about samples
design = ~ chemical
# design = ~ chemical + duration # only works if have all durations?
)
dds
table(metadata_markdups$chemical, metadata_markdups$duration)
