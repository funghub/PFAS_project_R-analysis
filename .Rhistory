#
# head(markdups_counts_ref_cleancols)
# head(raw_counts_ref_cleancols)
# dds = DESeqDataSet
dds <- DESeqDataSetFromMatrix(
countData = markdups_counts_aligned, # sample gene counts unnormalized
colData = metadata_markdups, # metadata info about samples
design = ~ chemical
# design = ~ chemical + duration # only works if have all durations?
)
dds
table(metadata_markdups$chemical, metadata_markdups$duration)
head(metadata_markdups)
unique(metadata_markdups$chemical)
# unique(metadata_markdups$chemical)[2]
# number of unique combos for chem, duration, dose
count(metadata_markdups, chemical, duration, dose)
min(count(metadata_markdups, chemical, duration, dose)$n)
# Pre-filtering: Remove low count genes
# dds <- dds[rowSums(counts(dds)) > 0, ] #10
# head(dds)
smallestGroupSize <- min(count(metadata_markdups, chemical, dose)$n) # smallest replicate number
# keep <- rowSums(counts(dds) >= 10) >= smallestGroupSize # original
# keep <- rowSums(counts(dds, normalized=TRUE) > 0) >= smallestGroupSize
keep <- rowSums(counts(dds) > 0) >= smallestGroupSize
dds <- dds[keep,]
# counts(dds)
# running the differential expression pipeline
dds <- DESeq(dds)
# extracts the estimated log2 fold changes and p values for the last variable in the design formula
# build results table
results <- results(dds)
results <- results[order(results$padj), ]
head(results)
# PCA plot
vsd <- vst(dds, blind = TRUE)  # Variance-stabilizing transformation
plotPCA(vsd, intgroup = "chemical") # changed Condition to chemical to match metadata
# subset the samples and then run it again!
# try all samples with t-SNE to see if separate better
# Heatmap of Sample Distances
sampleDists <- dist(t(assay(vsd)))
sampleDistMatrix <- as.matrix(sampleDists)
pheatmap(sampleDistMatrix, main = "Sample Distance Heatmap")
# Add significance column
results$significant <- results$padj < 0.05 & abs(results$log2FoldChange) > 1
# Volcano plot
ggplot(results, aes(x = log2FoldChange, y = -log10(pvalue), color = significant)) +
geom_point() +
theme_minimal() +
labs(x = "Log2 Fold Change", y = "-Log10 P-value")
# EXAMPLE CODE to subset in the future simpler for faster deseq results
# subset metadata to just this comparison group (or leave it broad if combining all chemicals)
coldata <- GSMtoSRR %>%
filter(chemical.y %in% c("DMSO","PFOA","PFBS","PFOS","PFDS") & duration == 1) %>%
column_to_rownames("SRR")
